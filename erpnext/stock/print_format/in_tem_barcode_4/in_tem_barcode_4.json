 "html": "<head>\r\n  <meta name=\"pdfkit-orientation\" content=\"Portrait\"/>\r\n</head>\r\n\r\n<style>\r\n  @page {\r\n    size: A4 portrait;   /* A4 d\u1ecdc */\r\n    margin: 0;\r\n  }\r\n\r\n  body {\r\n    margin: 0;\r\n    padding: 0;\r\n  }\r\n\r\n  table.page {\r\n    width: 210mm;        /* A4 d\u1ecdc */\r\n    height: 297mm;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n  }\r\n\r\n  table.page td {\r\n    width: 210mm;        /* full ngang */\r\n    height: 148.5mm;     /* n\u1eeda d\u1ecdc */\r\n    border: 1px solid #000;\r\n    text-align: center;\r\n    vertical-align: middle;\r\n    page-break-inside: avoid;\r\n  }\r\n\r\n  .qr {\r\n    width: 70mm;\r\n    height: 70mm;\r\n  }\r\n\r\n  .text {\r\n    margin-top: 3mm;\r\n    font-size: 40pt;\r\n    font-weight: bold;\r\n    line-height: 1.2;\r\n    word-break: break-word;\r\n  }\r\n\r\n  .page-break { page-break-after: always; }\r\n</style>\r\n\r\n{% set items = doc.items %}\r\n{% for i in range(0, items|length, 2) %}\r\n  <table class=\"page\">\r\n    <tr>\r\n      {% set idx = i %}\r\n      <td>\r\n        {% if idx < items|length %}\r\n          <img class=\"qr\" src=\"{{ qrcode_generate(items[idx].item_code) }}\">\r\n          <div class=\"text\">\r\n            {{ items[idx].item_code }} - {{ items[idx].item_name }}\r\n            {% if items[idx].custom_kt %}<br>KT: {{ items[idx].custom_kt }}{% endif %}\r\n          </div>\r\n        {% endif %}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      {% set idx = i + 1 %}\r\n      <td>\r\n        {% if idx < items|length %}\r\n          <img class=\"qr\" src=\"{{ qrcode_generate(items[idx].item_code) }}\">\r\n          <div class=\"text\">\r\n            {{ items[idx].item_code }} - {{ items[idx].item_name }}\r\n            {% if items[idx].custom_kt %}<br>KT: {{ items[idx].custom_kt }}{% endif %}\r\n          </div>\r\n        {% endif %}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n  {% if i + 2 < items|length %}<div class=\"page-break\"></div>{% endif %}\r\n{% endfor %}\r\n",
